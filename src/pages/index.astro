---
import fs from "node:fs/promises";
import path from "node:path";

const pdfFileName = "aviso_estacionamento_A5_paisagem_METO_corrigido.pdf";
const ufs = [
  "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA",
  "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN",
  "RS", "RO", "RR", "SC", "SP", "SE", "TO"
];

interface AgentRecord {
  number: number;
  formattedNumber: string;
  id: string;
  codinome: string;
  cidade: string;
  uf: string;
  date: string;
}

let lastNumber = 0;
let recentAgents: AgentRecord[] = [];

try {
  const dbPath = path.resolve(process.cwd(), "data", "agentes.json");
  const raw = await fs.readFile(dbPath, "utf-8");
  const parsed = JSON.parse(raw);
  lastNumber = typeof parsed.lastNumber === "number" ? parsed.lastNumber : 0;
  recentAgents = Array.isArray(parsed.agents) ? parsed.agents : [];
} catch {
  lastNumber = 0;
  recentAgents = [];
}

const nextFormatted = String(lastNumber + 1).padStart(4, "0");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>METO — Movimento Ética para Todos</title>
    <meta
      name="description"
      content="Movimento Ética para Todos (METO). Inscrição rápida com carteirinha numerada sequencialmente e download oficial do aviso de estacionamento irregular (A5 Paisagem)."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="container">
      <!-- TOP BAR / STATUS -->
      <header class="topbar no-print">
        <div class="topbar-brand">
          <span class="badge-dot"></span>
          <strong>METO</strong> — Movimento Ética para Todos
        </div>
        <div class="topbar-stats">
          <span>Carteirinhas emitidas: <strong id="agent-counter">{lastNumber}</strong></span>
          <span class="topbar-sep">|</span>
          <span>Próximo Nº: <strong id="topbar-next-num">#{nextFormatted}</strong></span>
        </div>
      </header>

      <!-- HERO / REPLICA OF THE A5 NOTICE -->
      <section class="notice-wrapper" aria-label="Prévia do Aviso Oficial METO">
        <div class="section-tag no-print">DOCUMENTO OFICIAL — FORMATO A5 PAISAGEM</div>

        <article class="a5-sheet" id="printable-notice">
          <p class="a5-header">Movimento Ética para Todos - METO</p>

          <div class="a5-body">
            <h1 class="a5-title">ESTACIONAMENTO IRREGULAR</h1>

            <p class="a5-text">
              Você está numa vaga que exige autorização especial<br />
              que você não colocou.
            </p>

            <p class="a5-punchline">
              Ah! Não tem? Então não faça mais isso,<br />
              seu filho (ou sua filha) da puta do caralho.
            </p>
          </div>

          <p class="a5-footer">Movimento Ética para Todos - METO</p>
        </article>

        <!-- DIRECT DOWNLOAD & ACTIONS BAR -->
        <div class="actions-bar no-print">
          <a
            href={`/${pdfFileName}`}
            download={pdfFileName}
            class="btn btn-primary"
            id="btn-download-pdf"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
              <path d="M12 3v13M5 11l7 7 7-7M4 21h16" />
            </svg>
            BAIXAR ARQUIVO PDF (A5 PAISAGEM)
          </a>

          <a
            href={`/${pdfFileName}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            ABRIR PDF NO NAVEGADOR
          </a>

          <button type="button" class="btn btn-outline" id="btn-print-notice">
            IMPRIMIR DIRETO
          </button>
        </div>

        <p class="specs-note no-print">
          Arquivo original: <code>{pdfFileName}</code> (422 KB • Pronto para impressão em folha A4 ou A5).
        </p>
      </section>

      <!-- TWO-COLUMN GRID: FAST REGISTRATION + INSTRUCTIONS -->
      <section class="grid-section no-print">
        <!-- REGISTRATION BOX -->
        <div class="box" id="inscricao">
          <div class="box-header">
            <span class="step-num">01</span>
            <h2>INSCRIÇÃO RÁPIDA DE AGENTE</h2>
          </div>

          <div class="next-seq-banner">
            <span>PRÓXIMA CARTEIRINHA DISPONÍVEL:</span>
            <strong id="form-next-seq">Nº {nextFormatted}</strong>
          </div>

          <p class="box-desc">
            Sem CPF, sem RG, sem e-mail e sem frescura. Basta um codinome e sua cidade para emitir sua carteirinha com numeração sequencial.
          </p>

          <form id="meto-form" class="meto-form" autocomplete="off">
            <div class="field">
              <label for="codinome">APELIDO OU CODINOME *</label>
              <input
                type="text"
                id="codinome"
                name="codinome"
                required
                maxlength="36"
                placeholder="Ex: Cidadão Pistola, Fiscal do Asfalto..."
              />
            </div>

            <div class="field-row">
              <div class="field field-city">
                <label for="cidade">CIDADE *</label>
                <input
                  type="text"
                  id="cidade"
                  name="cidade"
                  required
                  maxlength="40"
                  placeholder="Ex: São Paulo"
                />
              </div>

              <div class="field field-uf">
                <label for="uf">UF *</label>
                <select id="uf" name="uf" required>
                  <option value="" disabled selected>UF</option>
                  {ufs.map((uf) => <option value={uf}>{uf}</option>)}
                </select>
              </div>
            </div>

            <div class="field">
              <label for="compromisso" class="checkbox-label">
                <input type="checkbox" id="compromisso" required checked />
                <span>
                  Comprometo-me a deixar este aviso no para-brisa de quem estaciona onde não deve.
                </span>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-full" id="btn-submit-form">
              GERAR CARTEIRINHA SEQUENCIAL
            </button>
          </form>

          <!-- GENERATED CREDENTIAL CARD (HIDDEN UNTIL REGISTERED) -->
          <div id="credential-result" class="credential-card" hidden>
            <div class="credential-border">
              <div class="credential-top">
                <span>Movimento Ética para Todos - METO</span>
                <span class="cred-status">ATIVA</span>
              </div>

              <div class="cred-seq-box">
                <span class="cred-seq-label">CARTEIRINHA OFICIAL</span>
                <strong class="cred-seq-number" id="cred-seq-number">Nº 0001</strong>
              </div>

              <div class="credential-main">
                <p class="cred-label">AGENTE CREDENCIADO(A)</p>
                <h3 class="cred-name" id="cred-name">—</h3>
                <p class="cred-meta">
                  <span>MATRÍCULA: <strong id="cred-id">METO-0001/SP</strong></span>
                  <span>BASE: <strong id="cred-location">—</strong></span>
                  <span>EMISSÃO: <strong id="cred-date">—</strong></span>
                </p>
              </div>

              <p class="credential-quote">
                “Autorizado(a) a educar motoristas folgados com a sutileza que eles merecem.”
              </p>
            </div>

            <div class="credential-actions">
              <button type="button" id="btn-download-cred" class="btn btn-primary btn-small">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
                  <path d="M12 3v13M5 11l7 7 7-7M4 21h16" />
                </svg>
                BAIXAR CARTEIRINHA (PNG)
              </button>
              <button type="button" id="btn-print-cred" class="btn btn-outline btn-small">
                SALVAR CARTEIRINHA EM PDF
              </button>
              <a
                href={`/${pdfFileName}`}
                download={pdfFileName}
                class="btn btn-outline btn-small"
              >
                BAIXAR AVISO A5 (PDF)
              </a>
              <button type="button" id="btn-new-cred" class="btn btn-outline btn-small">
                + EMITIR NOVA CARTEIRINHA (PRÓXIMO Nº)
              </button>
            </div>
          </div>
        </div>

        <!-- PROTOCOL / HOW IT WORKS BOX -->
        <div class="box">
          <div class="box-header">
            <span class="step-num">02</span>
            <h2>PROTOCOLO DE AÇÃO</h2>
          </div>

          <ol class="protocol-list">
            <li>
              <strong>Baixe e imprima o PDF</strong>
              <p>
                O arquivo oficial está diagramado em formato <strong>A5 Paisagem</strong> com borda preta de alto contraste. Imprima algumas cópias e deixe no porta-luvas.
              </p>
            </li>
            <li>
              <strong>Identifique a infração</strong>
              <p>
                Vaga de idoso, vaga PCD ou vaga exclusiva ocupada sem credencial visível no painel? O alvo foi localizado.
              </p>
            </li>
            <li>
              <strong>Aplique a notificação educativa</strong>
              <p>
                Posicione o aviso sob a palheta do limpador de para-brisa com o texto voltado para fora, garantindo leitura imediata pelo infrator e pelos pedestres.
              </p>
            </li>
          </ol>

          <div class="recent-agents">
            <p class="recent-title">REGISTRO SEQUENCIAL DE CARTEIRINHAS EMITIDAS</p>
            <ul id="recent-list" class="recent-list">
              {recentAgents.length === 0 ? (
                <li class="empty-item" id="empty-agents-msg">
                  Nenhuma carteirinha emitida ainda. Seja o Nº 0001!
                </li>
              ) : (
                recentAgents.map((agent) => (
                  <li>
                    <span><strong>Nº {agent.formattedNumber}</strong> — {agent.codinome} ({agent.cidade}/{agent.uf})</span>
                    <button
                      type="button"
                      class="btn-inline-download"
                      data-agent={JSON.stringify(agent)}
                      title={`Baixar Carteirinha Nº ${agent.formattedNumber}`}
                    >
                      [Baixar Carteirinha]
                    </button>
                  </li>
                ))
              )}
            </ul>
          </div>
        </div>
      </section>

      <footer class="footer no-print">
        <p><strong>Movimento Ética para Todos - METO</strong></p>
        <p>Inscrição anônima com numeração sequencial automática. A ética começa na vaga.</p>
      </footer>
    </main>

    <script>
      const STORAGE_KEY = "meto_last_credential_v2";
      const LOCAL_SEQ_KEY = "meto_local_seq_counter_v2";
      const LOCAL_AGENTS_KEY = "meto_agents_list_v2";

      const form = document.getElementById("meto-form") as HTMLFormElement | null;
      const btnSubmit = document.getElementById("btn-submit-form") as HTMLButtonElement | null;
      const credBox = document.getElementById("credential-result");
      const credSeqNumberEl = document.getElementById("cred-seq-number");
      const credIdEl = document.getElementById("cred-id");
      const credNameEl = document.getElementById("cred-name");
      const credLocEl = document.getElementById("cred-location");
      const credDateEl = document.getElementById("cred-date");
      const counterEl = document.getElementById("agent-counter");
      const topbarNextNumEl = document.getElementById("topbar-next-num");
      const formNextSeqEl = document.getElementById("form-next-seq");
      const recentListEl = document.getElementById("recent-list");
      const btnNewCred = document.getElementById("btn-new-cred");
      const btnDownloadCred = document.getElementById("btn-download-cred");
      const btnPrintCred = document.getElementById("btn-print-cred");
      const btnPrint = document.getElementById("btn-print-notice");

      let currentCredential: AgentCredential | null = null;

      interface AgentCredential {
        number: number;
        formattedNumber: string;
        id: string;
        codinome: string;
        cidade: string;
        uf: string;
        date: string;
      }

      function padSequential(num: number): string {
        return String(num).padStart(4, "0");
      }

      const LOWERCASE_WORDS = new Set([
        "da", "de", "do", "das", "dos", "e", "em", "na", "no", "nas", "nos"
      ]);

      function formatProperName(value: string): string {
        return String(value || "")
          .trim()
          .replace(/\s+/g, " ")
          .toLowerCase()
          .split(" ")
          .filter(Boolean)
          .map((word, index) => {
            if (index > 0 && LOWERCASE_WORDS.has(word)) {
              return word;
            }
            return word.charAt(0).toUpperCase() + word.slice(1);
          })
          .join(" ");
      }

      function downloadCredentialAsPng(data: AgentCredential) {
        const canvas = document.createElement("canvas");
        canvas.width = 1000;
        canvas.height = 630;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        // Background
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Outer thick border
        ctx.strokeStyle = "#000000";
        ctx.lineWidth = 10;
        ctx.strokeRect(20, 20, canvas.width - 40, canvas.height - 40);

        // Inner thin border
        ctx.lineWidth = 3;
        ctx.strokeRect(36, 36, canvas.width - 72, canvas.height - 72);

        // Top header bar
        ctx.fillStyle = "#000000";
        ctx.font = "bold 22px Verdana, sans-serif";
        ctx.textAlign = "left";
        ctx.fillText("Movimento Ética para Todos - METO", 64, 84);

        // ATIVA badge
        ctx.fillStyle = "#000000";
        ctx.fillRect(canvas.width - 170, 56, 106, 36);
        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 18px Verdana, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("ATIVA", canvas.width - 117, 80);

        // Header divider line
        ctx.strokeStyle = "#000000";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(64, 106);
        ctx.lineTo(canvas.width - 64, 106);
        ctx.stroke();

        // Black box for sequential number
        ctx.fillStyle = "#000000";
        ctx.fillRect(64, 130, canvas.width - 128, 125);

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 18px Verdana, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("CARTEIRINHA OFICIAL DE FISCALIZAÇÃO ÉTICA", canvas.width / 2, 168);

        ctx.font = "bold 54px Verdana, sans-serif";
        ctx.fillText(`Nº ${data.formattedNumber}`, canvas.width / 2, 232);

        // Agent label & name
        ctx.fillStyle = "#000000";
        ctx.font = "bold 18px Verdana, sans-serif";
        ctx.fillText("AGENTE CREDENCIADO(A)", canvas.width / 2, 305);

        ctx.font = "bold 40px Verdana, sans-serif";
        const displayCodinome = data.codinome.length > 28 ? data.codinome.slice(0, 28) + "…" : data.codinome;
        ctx.fillText(displayCodinome, canvas.width / 2, 360);

        // Metadata line
        ctx.font = "21px Verdana, sans-serif";
        const metaText = `MATRÍCULA: ${data.id}   •   BASE: ${data.cidade}/${data.uf}   •   EMISSÃO: ${data.date}`;
        ctx.fillText(metaText, canvas.width / 2, 420);

        // Dashed separator
        ctx.setLineDash([8, 6]);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(64, 465);
        ctx.lineTo(canvas.width - 64, 465);
        ctx.stroke();
        ctx.setLineDash([]);

        // Quote
        ctx.font = "italic 21px Verdana, sans-serif";
        ctx.fillText(
          "“Autorizado(a) a educar motoristas folgados com a sutileza que eles merecem.”",
          canvas.width / 2,
          515
        );

        // Footer
        ctx.font = "bold 17px Verdana, sans-serif";
        ctx.fillText("Movimento Ética para Todos - METO", canvas.width / 2, 565);

        // Trigger download
        const link = document.createElement("a");
        link.download = `carteirinha_METO_${data.formattedNumber}.png`;
        link.href = canvas.toDataURL("image/png");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      function printCredentialWindow(data: AgentCredential) {
        const win = window.open("", "_blank", "width=800,height=600");
        if (!win) return;
        win.document.write(`<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title>Carteirinha METO Nº ${data.formattedNumber}</title>
  <style>
    @page { size: A6 landscape; margin: 8mm; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Verdana, sans-serif; background: #fff; color: #000; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 16px; }
    .card { border: 5px solid #000; padding: 24px; width: 100%; max-width: 620px; text-align: center; }
    .top { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #000; padding-bottom: 10px; margin-bottom: 16px; font-size: 13px; font-weight: 700; }
    .badge { background: #000; color: #fff; padding: 3px 10px; font-size: 11px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .seq { background: #000; color: #fff; padding: 14px; margin-bottom: 18px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .seq small { display: block; font-size: 11px; letter-spacing: 0.1em; margin-bottom: 4px; }
    .seq strong { font-size: 32px; letter-spacing: 0.05em; }
    .label { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; margin-bottom: 6px; }
    .name { font-size: 26px; font-weight: 700; margin-bottom: 14px; }
    .meta { font-size: 13px; margin-bottom: 18px; }
    .quote { border-top: 2px dashed #000; padding-top: 12px; font-size: 13px; font-style: italic; }
  </style>
</head>
<body>
  <div class="card">
    <div class="top">
      <span>Movimento Ética para Todos - METO</span>
      <span class="badge">ATIVA</span>
    </div>
    <div class="seq">
      <small>CARTEIRINHA OFICIAL DE FISCALIZAÇÃO ÉTICA</small>
      <strong>Nº ${data.formattedNumber}</strong>
    </div>
    <p class="label">AGENTE CREDENCIADO(A)</p>
    <h1 class="name">${data.codinome}</h1>
    <p class="meta"><strong>MATRÍCULA:</strong> ${data.id} &nbsp;|&nbsp; <strong>BASE:</strong> ${data.cidade}/${data.uf} &nbsp;|&nbsp; <strong>EMISSÃO:</strong> ${data.date}</p>
    <p class="quote">“Autorizado(a) a educar motoristas folgados com a sutileza que eles merecem.”</p>
  </div>
  <script>window.onload = () => { window.print(); };<\/script>
</body>
</html>`);
        win.document.close();
      }

      function updateCountersUI(lastNumber: number, nextFormatted: string) {
        if (counterEl) counterEl.textContent = String(lastNumber);
        if (topbarNextNumEl) topbarNextNumEl.textContent = `#${nextFormatted}`;
        if (formNextSeqEl) formNextSeqEl.textContent = `Nº ${nextFormatted}`;
      }

      function renderAgentsList(agents: AgentCredential[]) {
        if (!recentListEl) return;
        recentListEl.innerHTML = "";
        if (agents.length === 0) {
          const li = document.createElement("li");
          li.className = "empty-item";
          li.textContent = "Nenhuma carteirinha emitida ainda. Seja o Nº 0001!";
          recentListEl.appendChild(li);
          return;
        }

        for (const agent of agents) {
          const cleanCodinome = formatProperName(agent.codinome);
          const cleanCidade = formatProperName(agent.cidade);
          const normalizedAgent = { ...agent, codinome: cleanCodinome, cidade: cleanCidade };

          const li = document.createElement("li");
          const left = document.createElement("span");
          const strong = document.createElement("strong");
          strong.textContent = `Nº ${agent.formattedNumber}`;
          left.appendChild(strong);
          left.appendChild(document.createTextNode(` — ${cleanCodinome} (${cleanCidade}/${agent.uf})`));

          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "btn-inline-download";
          btn.textContent = "[Baixar Carteirinha]";
          btn.addEventListener("click", () => {
            renderCredential(normalizedAgent);
            downloadCredentialAsPng(normalizedAgent);
          });

          li.appendChild(left);
          li.appendChild(btn);
          recentListEl.appendChild(li);
        }
      }

      function renderCredential(data: AgentCredential) {
        if (!form || !credBox || !credSeqNumberEl || !credIdEl || !credNameEl || !credLocEl || !credDateEl) return;

        const normalized: AgentCredential = {
          ...data,
          codinome: formatProperName(data.codinome),
          cidade: formatProperName(data.cidade),
        };

        currentCredential = normalized;
        credSeqNumberEl.textContent = `Nº ${normalized.formattedNumber}`;
        credIdEl.textContent = normalized.id;
        credNameEl.textContent = normalized.codinome;
        credLocEl.textContent = `${normalized.cidade}/${normalized.uf}`;
        credDateEl.textContent = normalized.date;

        form.hidden = true;
        credBox.hidden = false;
      }

      function getLocalAgents(): AgentCredential[] {
        try {
          const raw = localStorage.getItem(LOCAL_AGENTS_KEY);
          if (!raw) return [];
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }

      // Sync with backend sequential counter on load (with localStorage fallback)
      async function syncSequentialState() {
        try {
          const res = await fetch("/api/inscricao");
          if (res.ok) {
            const data = await res.json();
            updateCountersUI(data.lastNumber, data.nextFormattedNumber);
            renderAgentsList(data.agents || []);
            localStorage.setItem(LOCAL_SEQ_KEY, String(data.lastNumber));
            localStorage.setItem(LOCAL_AGENTS_KEY, JSON.stringify(data.agents || []));
            return;
          }
        } catch {
          // Offline/static fallback
        }
        const localAgents = getLocalAgents();
        const localSeq = parseInt(localStorage.getItem(LOCAL_SEQ_KEY) || String(localAgents.length), 10);
        updateCountersUI(localSeq, padSequential(localSeq + 1));
        renderAgentsList(localAgents);
      }

      const savedRaw = localStorage.getItem(STORAGE_KEY);
      if (savedRaw) {
        try {
          const parsed = JSON.parse(savedRaw) as AgentCredential;
          if (parsed && parsed.formattedNumber) {
            renderCredential(parsed);
          }
        } catch {
          localStorage.removeItem(STORAGE_KEY);
        }
      }

      syncSequentialState();

      const codinomeField = document.getElementById("codinome") as HTMLInputElement | null;
      const cidadeField = document.getElementById("cidade") as HTMLInputElement | null;

      codinomeField?.addEventListener("blur", () => {
        if (codinomeField.value.trim()) {
          codinomeField.value = formatProperName(codinomeField.value);
        }
      });

      cidadeField?.addEventListener("blur", () => {
        if (cidadeField.value.trim()) {
          cidadeField.value = formatProperName(cidadeField.value);
        }
      });

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const codinomeInput = document.getElementById("codinome") as HTMLInputElement;
        const cidadeInput = document.getElementById("cidade") as HTMLInputElement;
        const ufSelect = document.getElementById("uf") as HTMLSelectElement;

        const codinome = formatProperName(codinomeInput.value);
        const cidade = formatProperName(cidadeInput.value);
        const uf = ufSelect.value.trim();

        codinomeInput.value = codinome;
        cidadeInput.value = cidade;

        if (!codinome || !cidade || !uf) return;

        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.textContent = "EMITINDO Nº SEQUENCIAL...";
        }

        try {
          const response = await fetch("/api/inscricao", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ codinome, cidade, uf }),
          });

          if (!response.ok) throw new Error("API error");

          const result = await response.json();
          const credential: AgentCredential = result.credential;

          localStorage.setItem(STORAGE_KEY, JSON.stringify(credential));
          localStorage.setItem(LOCAL_SEQ_KEY, String(credential.number));
          localStorage.setItem(LOCAL_AGENTS_KEY, JSON.stringify(result.agents || []));

          updateCountersUI(result.lastNumber, result.nextFormattedNumber);
          renderAgentsList(result.agents || []);
          renderCredential(credential);
          form.reset();
        } catch {
          // Fallback to localStorage sequential counter if server endpoint is unavailable
          const localAgents = getLocalAgents();
          const currentLocal = Math.max(
            parseInt(localStorage.getItem(LOCAL_SEQ_KEY) || "0", 10),
            localAgents.length
          );
          const nextNum = currentLocal + 1;
          const formattedNumber = padSequential(nextNum);
          const credential: AgentCredential = {
            number: nextNum,
            formattedNumber,
            id: `METO-${formattedNumber}/${uf}`,
            codinome,
            cidade,
            uf,
            date: new Date().toLocaleDateString("pt-BR"),
          };

          localAgents.unshift(credential);
          localStorage.setItem(LOCAL_SEQ_KEY, String(nextNum));
          localStorage.setItem(LOCAL_AGENTS_KEY, JSON.stringify(localAgents));
          localStorage.setItem(STORAGE_KEY, JSON.stringify(credential));
          updateCountersUI(nextNum, padSequential(nextNum + 1));
          renderAgentsList(localAgents);
          renderCredential(credential);
          form.reset();
        } finally {
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.textContent = "GERAR CARTEIRINHA SEQUENCIAL";
          }
        }
      });

      btnDownloadCred?.addEventListener("click", () => {
        if (currentCredential) {
          downloadCredentialAsPng(currentCredential);
        }
      });

      btnPrintCred?.addEventListener("click", () => {
        if (currentCredential) {
          printCredentialWindow(currentCredential);
        }
      });

      btnNewCred?.addEventListener("click", () => {
        if (!form || !credBox) return;
        credBox.hidden = true;
        form.hidden = false;
        const codinomeInput = document.getElementById("codinome") as HTMLInputElement | null;
        codinomeInput?.focus();
      });

      btnPrint?.addEventListener("click", () => {
        window.print();
      });
    </script>

    <style>
      :root {
        --bg: #ffffff;
        --fg: #000000;
        --muted: #333333;
        --border-thick: 4px solid #000000;
        --border-thin: 2px solid #000000;
        --font-main: Verdana, "DejaVu Sans", Geneva, Tahoma, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg);
        color: var(--fg);
        font-family: var(--font-main);
        line-height: 1.45;
        padding: 1.25rem 1rem 4.5rem;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 980px;
        margin: 0 auto;
      }

      /* TOPBAR */
      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        border-bottom: var(--border-thin);
        padding-bottom: 0.85rem;
        margin-bottom: 2rem;
        font-size: 0.85rem;
        letter-spacing: 0.02em;
      }

      .topbar-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .topbar-stats {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .topbar-sep {
        opacity: 0.4;
      }

      .badge-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        background: #000;
      }

      /* A5 SHEET REPLICA (EXACT PDF ESTHETIC) */
      .notice-wrapper {
        margin-bottom: 2.75rem;
      }

      .section-tag {
        display: inline-block;
        background: #000;
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding: 0.3rem 0.65rem;
        margin-bottom: 0.5rem;
      }

      .a5-sheet {
        border: var(--border-thick);
        background: #ffffff;
        aspect-ratio: 210 / 148;
        max-height: 460px;
        width: 100%;
        padding: 1.75rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        text-align: center;
        box-shadow: 8px 8px 0px #000000;
      }

      .a5-header,
      .a5-footer {
        font-size: clamp(0.85rem, 1.6vw, 1.15rem);
        font-weight: 700;
        letter-spacing: 0.01em;
      }

      .a5-body {
        margin: auto 0;
        width: 100%;
      }

      .a5-title {
        font-size: clamp(1.45rem, 4.2vw, 2.85rem);
        font-weight: 800;
        letter-spacing: 0.02em;
        margin-bottom: 2rem;
        line-height: 1.15;
      }

      .a5-text {
        font-size: clamp(1rem, 2.2vw, 1.55rem);
        font-weight: 400;
        line-height: 1.6;
        margin-bottom: 1.6rem;
      }

      .a5-punchline {
        font-size: clamp(1.05rem, 2.25vw, 1.6rem);
        font-weight: 700;
        line-height: 1.6;
      }

      /* ACTIONS BAR */
      .actions-bar {
        margin-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-family: var(--font-main);
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.9rem 1.35rem;
        border: var(--border-thin);
        cursor: pointer;
        transition: transform 0.1s ease, background-color 0.1s ease, color 0.1s ease;
        letter-spacing: 0.02em;
      }

      .btn:active {
        transform: translate(2px, 2px);
      }

      .btn-primary {
        background: #000000;
        color: #ffffff;
        box-shadow: 4px 4px 0px #000000;
      }

      .btn-primary:hover {
        background: #222222;
      }

      .btn-outline {
        background: #ffffff;
        color: #000000;
        box-shadow: 4px 4px 0px #000000;
      }

      .btn-outline:hover {
        background: #000000;
        color: #ffffff;
      }

      .btn-full {
        width: 100%;
      }

      .btn-small {
        padding: 0.65rem 1rem;
        font-size: 0.78rem;
      }

      .specs-note {
        margin-top: 0.9rem;
        font-size: 0.78rem;
        color: var(--muted);
      }

      .specs-note code {
        background: #f2f2f2;
        padding: 0.15rem 0.35rem;
        border: 1px solid #000;
        font-size: 0.75rem;
      }

      /* TWO-COLUMN SECTION */
      .grid-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.75rem;
        margin-bottom: 3rem;
      }

      .box {
        border: var(--border-thick);
        padding: 1.75rem;
        background: #ffffff;
        box-shadow: 6px 6px 0px #000000;
        display: flex;
        flex-direction: column;
      }

      .box-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: var(--border-thin);
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
      }

      .step-num {
        background: #000;
        color: #fff;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
      }

      .box-header h2 {
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .next-seq-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: var(--border-thin);
        background: #f7f7f7;
        padding: 0.5rem 0.75rem;
        margin-bottom: 1rem;
        font-size: 0.76rem;
        letter-spacing: 0.03em;
      }

      .next-seq-banner strong {
        background: #000;
        color: #fff;
        padding: 0.15rem 0.5rem;
        font-size: 0.85rem;
      }

      .box-desc {
        font-size: 0.85rem;
        margin-bottom: 1.15rem;
        color: var(--muted);
      }

      /* FORM */
      .meto-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .field-row {
        display: grid;
        grid-template-columns: 1fr 95px;
        gap: 0.75rem;
      }

      label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      input[type="text"],
      select {
        font-family: var(--font-main);
        font-size: 0.92rem;
        padding: 0.7rem 0.75rem;
        border: var(--border-thin);
        background: #fff;
        color: #000;
        outline: none;
      }

      input[type="text"]:focus,
      select:focus {
        box-shadow: 3px 3px 0px #000;
      }

      .checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        font-size: 0.8rem;
        font-weight: 400;
        cursor: pointer;
        line-height: 1.35;
        margin: 0.25rem 0;
      }

      .checkbox-label input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #000000;
        margin-top: 1px;
        flex-shrink: 0;
      }

      /* CREDENTIAL CARD */
      .credential-card {
        margin-top: 0.25rem;
      }

      .credential-border {
        border: 3px solid #000;
        padding: 1.25rem;
        text-align: center;
        background: #fff;
      }

      .credential-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #000;
        padding-bottom: 0.5rem;
        margin-bottom: 0.9rem;
        font-size: 0.72rem;
        font-weight: 700;
      }

      .cred-status {
        background: #000;
        color: #fff;
        padding: 0.1rem 0.45rem;
        font-size: 0.68rem;
        letter-spacing: 0.06em;
      }

      .cred-seq-box {
        border: 2px solid #000;
        background: #000;
        color: #fff;
        padding: 0.6rem 0.75rem;
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
      }

      .cred-seq-label {
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        opacity: 0.85;
      }

      .cred-seq-number {
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: 0.06em;
      }

      .cred-label {
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        font-weight: 700;
        margin-bottom: 0.25rem;
      }

      .cred-name {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 0.65rem;
        word-break: break-word;
      }

      .cred-meta {
        display: flex;
        justify-content: center;
        gap: 0.85rem;
        flex-wrap: wrap;
        font-size: 0.75rem;
        margin-bottom: 1rem;
      }

      .credential-quote {
        font-size: 0.78rem;
        font-style: italic;
        border-top: 1px dashed #000;
        padding-top: 0.75rem;
      }

      .credential-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      /* PROTOCOL LIST */
      .protocol-list {
        list-style: none;
        counter-reset: step;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .protocol-list li {
        counter-increment: step;
        position: relative;
        padding-left: 2.1rem;
        font-size: 0.85rem;
      }

      .protocol-list li::before {
        content: counter(step) ".";
        position: absolute;
        left: 0;
        top: 0;
        font-weight: 700;
        font-size: 1rem;
      }

      .protocol-list li strong {
        display: block;
        margin-bottom: 0.2rem;
      }

      .recent-agents {
        margin-top: auto;
        border-top: var(--border-thin);
        padding-top: 1rem;
      }

      .recent-title {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-bottom: 0.6rem;
      }

      .recent-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        font-size: 0.78rem;
        max-height: 220px;
        overflow-y: auto;
        padding-right: 0.25rem;
      }

      .recent-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 1px dotted #999;
        padding-bottom: 0.35rem;
      }

      .btn-inline-download {
        background: none;
        border: none;
        font-family: var(--font-main);
        font-size: 0.72rem;
        font-weight: 700;
        color: #000;
        cursor: pointer;
        text-decoration: underline;
        padding: 0;
        flex-shrink: 0;
      }

      .btn-inline-download:hover {
        background: #000;
        color: #fff;
        text-decoration: none;
        padding: 0.1rem 0.3rem;
      }

      .recent-list li.empty-item {
        color: var(--muted);
        font-style: italic;
        border-bottom: none;
      }

      /* FOOTER */
      .footer {
        border-top: var(--border-thin);
        padding-top: 1.25rem;
        text-align: center;
        font-size: 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }

      @media (max-width: 768px) {
        .grid-section {
          grid-template-columns: 1fr;
        }

        .a5-sheet {
          aspect-ratio: auto;
          padding: 1.5rem 1.1rem;
          min-height: 280px;
        }

        .actions-bar .btn {
          width: 100%;
        }
      }

      /* PRINT MEDIA: PRINTS ONLY THE A5 NOTICE CLEANLY */
      @media print {
        @page {
          size: A5 landscape;
          margin: 8mm;
        }

        body {
          padding: 0;
        }

        .no-print {
          display: none !important;
        }

        .notice-wrapper {
          margin: 0;
        }

        .a5-sheet {
          box-shadow: none;
          width: 100%;
          height: 92vh;
        }
      }
    </style>
  </body>
</html>
